{
  "name": "@erwinkn/pierre-native",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Native Pierre diff viewer and editor for GPUIX",
  "repository": {
    "type": "git",
    "url": "https://github.com/erwinkn/pierre-native.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./diffs/*": "./src/diffs/*.ts",
    "./components": "./src/components/foundation.tsx",
    "./theme": "./src/diffs/theme.ts",
    "./playground": "./src/experiments/diffs/playground/app.tsx",
    "./diffs/components": "./src/diffs/components.tsx",
    "./editor": "./src/diffs/editor.ts"
  },
  "files": [
    "src",
    "vendor/pierre/src",
    "vendor/pierre/LICENSE.md",
    "vendor/pierre/manifest.json",
    "vendor/pierre-playground",
    "assets",
    "LICENSE",
    "NOTICE",
    "README.md",
    "vendor/licenses",
    "docs/architecture.md",
    "docs/api.md",
    "docs/playground.png"
  ],
  "peerDependencies": {
    "@gpuix/react": "0.9.0-cherry.1",
    "react": "^19.2.4"
  },
  "dependencies": {
    "@pierre/theme": "2.0.0",
    "culori": "4.0.2",
    "diff": "9.0.0",
    "lru_map": "0.4.1",
    "lucide-static": "0.577.0",
    "shiki": "4.4.1",
    "strip-ansi": "7.2.0",
    "@pierre/diffs": "1.4.3"
  },
  "devDependencies": {
    "@gpuix/native": "https://github.com/erwinkn/gpuix/releases/download/runtime-v0.9.0-cherry.1/gpuix-native-0.9.0-cherry.1.tgz",
    "@gpuix/react": "https://github.com/erwinkn/gpuix/releases/download/runtime-v0.9.0-cherry.1/gpuix-react-0.9.0-cherry.1.tgz",
    "@types/bun": "1.3.10",
    "@types/culori": "4.0.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests vendor/pierre/test",
    "dev": "GPUI_FONT_SMOOTHING=0 bun examples/bootstrap.ts",
    "build:web": "bun scripts/build-web.ts",
    "web": "bun scripts/serve.ts",
    "test:native": "bun scripts/test-native.ts",
    "test:browser": "bun scripts/browser-test.ts",
    "test:webgl": "PIERRE_WEB_BACKEND=webgl bun scripts/browser-test.ts",
    "build:native": "bun scripts/build-runtime.ts native",
    "build:wasm": "bun scripts/build-runtime.ts web",
    "build:desktop": "bun scripts/build-desktop.ts",
    "test:application": "bun scripts/test-application.ts",
    "test:source": "bun scripts/verify-pierre.ts",
    "test:package": "bun scripts/test-package.ts",
    "deploy": "bun run build:web && wrangler deploy",
    "preview": "wrangler dev"
  }
}
